-  : /^\d+x\d+$/.test(raw) ? raw.split("x").map(Number) : [1920, 1080];
+const k = raw === "4k" || raw === "2160p" ? 2 : raw === "1440p" ? 4 / 3 : 1;
+const [w, h] = /^\d+x\d+$/.test(raw) ? raw.split("x").map(Number) : frame.map((v) => Math.round((v * k) / 2) * 2);
