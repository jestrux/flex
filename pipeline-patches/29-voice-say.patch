-export async function voiceFor(text: string): Promise<{ file: string; dur: number }> {
+// Flex: words the voice would misread, as the project says them (voice.json "say", passed as VOICE_SAY): whole words,
+// spoken only; the line's own text (the subtitles) keeps the written word.
+const SAY: Record<string, string> = (() => { try { return JSON.parse(process.env.VOICE_SAY ?? "{}"); } catch { return {}; } })();
+const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+const spoken = (text: string) => Object.entries(SAY).reduce((t, [w, s]) => t.replace(new RegExp(`(?<![\\w-])${esc(w)}(?![\\w-])`, "g"), s), text);
+
+export async function voiceFor(written: string): Promise<{ file: string; dur: number }> {
+  const text = spoken(written);
   const file = join(CACHE, `${key(text)}.wav`);
   if (!existsSync(file) || statSync(file).size < 100) await (OPENAI_KEY ? openai(text, file) : kokoroSay(text, file));
   return { file, dur: wavDur(file) };
